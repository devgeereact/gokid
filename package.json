    "qa:sec": "node scripts/qa/01-idor.mjs && node scripts/qa/02-quiz-no-repeat.mjs && node scripts/qa/04-sync.mjs && node scripts/qa/05-verify-db.mjs && node scripts/qa/06-unauth-methods.mjs",
