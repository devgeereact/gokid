    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "check:audit": "node --import tsx --import ./scripts/asset-hook.mjs scripts/content-audit.mjs",
    "check:content:db": "node --import tsx --import ./scripts/asset-hook.mjs scripts/content-audit.mjs --db"
