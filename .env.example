# Copy to .env and fill in real values. .env is gitignored — never commit it.
# One KEY=VALUE per line. A missing newline concatenates the next key into the
# previous value, and Clerk will reject the resulting publishable key.
#
# Rule: only EXPO_PUBLIC_* reaches the app bundle. Everything else is a server
# secret — read it ONLY from Expo Router API routes (+api.ts) or Inngest jobs,
# never from a React component. See AGENTS.md §1.

# ===========================================================================
# Clerk — auth  (INSTALLED)  https://dashboard.clerk.com -> API keys
# ===========================================================================

# Client-safe. Metro only inlines EXPO_PUBLIC_* vars into the app bundle, so this
# prefix is required — NEXT_PUBLIC_ does not work in Expo.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-side only. Never prefix with EXPO_PUBLIC_ and never read from a React
# component — it must not reach the app bundle. Used by route handlers and
# Inngest functions.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================================================
# Neon Postgres — database  (INSTALLED)  https://console.neon.tech -> connection string
# ===========================================================================

# Server-side ONLY. Read by src/db/client.ts (Neon serverless driver over HTTP).
# NEVER add EXPO_PUBLIC_ — that would ship your DB credentials in the app bundle.
# Use the pooled connection string. Format:
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/gokid?sslmode=require

# ===========================================================================
# Sentry — monitoring  (INSTALLED)  https://sentry.io -> Settings -> Auth Tokens
# ===========================================================================

# Build-time only. Uploads source maps and debug symbols during `expo run:*`.
# The Sentry DSN is public and hardcoded in src/app/_layout.tsx — no env needed.
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================================================
# AI — content / image generation  (via OpenRouter)  https://openrouter.ai/keys
# ===========================================================================

# Server-side ONLY. Powers AI generation (quiz content, cover images) inside
# Inngest jobs / API routes. Never EXPO_PUBLIC_ — the key must stay server-side.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OpenRouter base URL (OpenAI-compatible endpoint).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Primary model for image generation.
OPENROUTER_MODEL=google/gemini-2.5-flash-image
# Fallback model if the primary is unavailable / rate-limited.
OPENROUTER_FALLBACK_MODEL=anthropic/claude-haiku-latest

# ===========================================================================
# ImageKit — image CDN / transforms  (NOT WIRED YET — AGENTS.md target stack)
# ===========================================================================
# Fill when ImageKit lands (child avatars, remote images). URL endpoint is
# client-safe; private key is server-side only. https://imagekit.io/dashboard

# Client-safe: the delivery/transform base URL.
EXPO_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# Client-safe: public API key (upload auth handshake).
EXPO_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxx
# Server-side ONLY: signs upload requests.
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================================================
# Inngest — background jobs  (NOT WIRED YET — AGENTS.md target stack)
# ===========================================================================
# Fill when Inngest lands (async/retryable/scheduled work). Server-side only.
# https://app.inngest.com -> Manage -> Keys
INNGEST_EVENT_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INNGEST_SIGNING_KEY=signkey-prod-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
