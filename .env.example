# Copy to .env and fill in real values. .env is gitignored — never commit it.
# One KEY=VALUE per line. A missing newline concatenates the next key into the
# previous value, and Clerk will reject the resulting publishable key.

# ---------------------------------------------------------------------------
# Clerk — https://dashboard.clerk.com → API keys
# ---------------------------------------------------------------------------

# Client-safe. Metro only inlines EXPO_PUBLIC_* vars into the app bundle, so this
# prefix is required — NEXT_PUBLIC_ does not work in Expo.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-side only. Never prefix this with EXPO_PUBLIC_ and never read it from a
# React component — it must not reach the app bundle. Used by route handlers and
# Inngest functions once those exist.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Sentry — https://sentry.io → Settings → Auth Tokens
# ---------------------------------------------------------------------------

# Build-time only. Uploads source maps and debug symbols during `expo run:*`.
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
