{
  "expo": {
    "name": "gokid",
    "slug": "gokid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gokid",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.gokid.app",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.gokid.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "gakinz",
          "project": "gokid"
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "GoKid uses your photos so you can set a picture for your child.",
          "cameraPermission": "GoKid uses your camera so you can take a picture for your child."
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "defaultChannel": "gokid-reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dd2da6fd-eb50-4bae-a6d0-3482d422f9c7"
      }
    },
    "owner": "gakinz"
  }
}
